{
  "name": "webgl_experiment",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.html",
  "scripts": {
    "format": "npx prettier --config ./dev-configs/prettier-config.json 'src/**/*.ts' --write",
    "build-safe-release": "npx bun run ./dev-configs/run-bundlers.js build-safe-release",
    "build-safe-debug": "npx bun run ./dev-configs/run-bundlers.js build-safe-debug",
    "build-fast-release": "npx bun run ./dev-configs/run-bundlers.js build-fast-release",
    "build-fast-debug": "npx bun run ./dev-configs/run-bundlers.js build-fast-debug",
    "watch": "npx nodemon --config ./dev-configs/nodemon-config.json --exec 'npm run build-fast-debug' --watch ./src",
    "release": "npm run build-safe-release",
    "debug": "npm run build-safe-debug"
  },
  "dependencies": {
    "config": "^3.3.11",
    "express": "^4.17.1",
    "websocket": "^1.0.32"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^23.0.2",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-terser": "^0.3.0",
    "@rollup/plugin-typescript": "^9.0.2",
    "@types/config": "^3.3.4",
    "@types/express": "^4.17.21",
    "@types/gl-matrix": "^3.2.0",
    "@types/node": "^15.6.1",
    "@types/websocket": "^1.0.10",
    "bun": "^1.0.18",
    "gl-matrix": "^3.3.0",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.4",
    "rollup": "^3.2.3",
    "tslib": "^2.5.0"
  }
}
