//   qr.y = (q1.w * q2.y) - (q1.x * q2.z) + (q1.y * q2.w) + (q1.z * q2.x);
//   qr.z = (q1.w * q2.z) + (q1.x * q2.y) - (q1.y * q2.x) + (q1.z * q2.w);
//   qr.w = (q1.w * q2.w) - (q1.x * q2.x) - (q1.y * q2.y) - (q1.z * q2.z);
//   return qr;
// }

// vec3 rotate_vec3(vec3 position, vec3 axis, float angle)
// {
//   vec4 qr = quat_from_axis_angle(axis, angle);
//   vec4 qr_conj = quat_conj(qr);
//   vec4 q_pos = vec4(position.x, position.y, position.z, 0);

//   vec4 q_tmp = quat_mult(qr, q_pos);
//   qr = quat_mult(q_tmp, qr_conj);

//   return vec3(qr.x, qr.y, qr.z);
// }

// vec3 rotate_vec3(vec3 position, vec3 axis, float angle)
// {
//   vec4 q = quat_from_axis_angle(axis, angle);
//   vec3 v = position.xyz;
//   return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
// }

vec3 apply_quat_to_vec3(vec3 position, vec4 q)
{
  vec3 v = position.xyz;
  return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}
#version 300 es

precision lowp float;

uniform vec3 u_viewPos;

const vec3 k_specularColor = vec3(1.0);

in vec4 v_color;
in vec3 v_worldSpacePosition;
in float v_worldSpaceNormalLength;
in vec3 v_worldSpaceNormal;

out vec4 out_color;

#include "./assets/graphics/shaders/_common/_common-apply-lighting.glsl.frag"

// float applySunLight_diffuse(vec3 inWorldNormal, vec3 inLightDir)
// {
//   return max(dot(-inLightDir, inWorldNormal), 0.0);
// }

// float applySunLight_specular(vec3 inWorldNormal, vec3 inWorldPos, vec3 inLightDir)
// {
//   vec3 reflectDir = reflect(inLightDir, inWorldNormal);
//   vec3 viewDir = normalize(u_viewPos - inWorldPos);
//   float specAngle = max(dot(reflectDir, viewDir), 0.0);
//   return pow(specAngle, 64.0);
// }

void main(void)
{
  vec3 lightDir = normalize(u_viewPos - v_worldSpacePosition);

  float sunDiffuseCoef = getDiffuseLightingRatio(lightDir, v_worldSpaceNormal);
  float sunSpecularCoef = 0.0;
  // if (sunDiffuseCoef > 0.0)
  // {
  //   sunSpecularCoef = getSpecularLightingRatio(v_worldSpaceNormal, v_worldSpacePosition, u_viewPos, lightDir);
  // }

  out_color = vec4(v_color.rgb * (0.2 + sunDiffuseCoef) + k_specularColor * sunSpecularCoef, 1.0);
}
#version 300 es

precision highp float;

uniform mat4 u_composedMatrix;

in vec3 a_vertexPosition;
in vec3 a_vertexNormal;

in vec3 a_offsetPosition;
in vec4 a_offsetOrientation; // quaternion
in vec3 a_offsetScale;
in vec4 a_offsetColor;

out vec4 v_color;
out vec3 v_worldSpacePosition;
out vec3 v_worldSpaceNormal;

#include "./assets/graphics/shaders/_common/_common-quat-rotations.glsl.vert"

void main(void)
{
	vec3 worldSpacePosition = a_offsetPosition + apply_quat_to_vec3(a_vertexPosition * a_offsetScale, a_offsetOrientation);
	vec3 worldSpaceNormal = apply_quat_to_vec3(a_vertexNormal, a_offsetOrientation);

	gl_Position = u_composedMatrix * vec4(worldSpacePosition, 1.0);

	v_color = a_offsetColor;
	v_worldSpacePosition = worldSpacePosition;
	v_worldSpaceNormal = worldSpaceNormal;
}
