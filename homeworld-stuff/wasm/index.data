#version 300 es

precision lowp float;
// precision highp float;

uniform sampler2D u_texture;
uniform vec4 u_outlineColor;

in vec3 v_color;
in vec2 v_texCoord;
// in float v_fogValue;

in vec3 v_normalInterp;
// in vec3 v_vertPos;
in vec3 v_lightDir;

layout(location=0) out vec4 o_color;
layout(location=1) out vec4 o_outlineColor;

#include "assets/shaders/_common-apply-lighting.frag"

// const vec4 fogColor = vec4(0.25, 0.25, 0.25, 1.0);
// const vec4 fogColor = vec4(0.0, 0.0, 0.0, 1.0);

// const vec3 k_lightPos = vec3(0.0, 0.0, 0.0);

void main(void)
{
	// vec4 textureColor = texture2D(u_texture, v_texCoord);
	vec4 textureColor = texture(u_texture, v_texCoord);

	vec4 currentColor = textureColor * vec4(v_color, 1.0);

	// currentColor = applyLighting(currentColor, v_normalInterp, v_vertPos);
	// vec3 lightDir = normalize(k_lightPos - v_vertPos);
	currentColor = applyLighting(currentColor, v_normalInterp, v_lightDir);

	// gl_FragColor = mix(currentColor, fogColor, v_fogValue);
	// o_color = mix(currentColor, fogColor, v_fogValue);
	o_color = currentColor;
	o_outlineColor = u_outlineColor;
}
