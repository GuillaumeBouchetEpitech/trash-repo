#version 300 es

precision highp float;

uniform mat4 u_projectionMatrix;
uniform mat4 u_modelViewMatrix;

in vec3  a_position;
// in vec2  a_texCoord;

in mat4  a_offsetTransform;
in vec4  a_offsetColor;
in vec4  a_offsetOutlineColor;
// in float a_offsetScale;

out vec4 v_color;
out vec4 v_outlineColor;
// out vec2 v_texCoord;

out vec3 v_normalInterp;

void main(void)
{
	mat4 tranform = u_modelViewMatrix * a_offsetTransform;

	// vec4 vertPos4 = tranform * vec4(a_position * a_offsetScale, 1.0);
	vec4 vertPos4 = tranform * vec4(a_position, 1.0);
	gl_Position = u_projectionMatrix * vertPos4;

	v_color = a_offsetColor;
	v_outlineColor = a_offsetOutlineColor;
	// v_texCoord = a_texCoord;
}
#version 300 es

precision highp float;

// uniform mat4 u_composedMatrix;
uniform mat4 u_projectionMatrix;
uniform mat4 u_modelViewMatrix;

in vec3  a_position;
in vec3  a_normal;
in vec2  a_texCoord;
in vec3  a_color;

out vec3 v_color;
out vec2 v_texCoord;
// out float v_fogValue;
out vec3 v_normalInterp;
// out vec3 v_vertPos;
out vec3 v_lightDir;

// #include "assets/shaders/_common-fog-logic.vert"

const vec3 k_lightPos = vec3(0.0, 0.0, 0.0);

void main(void)
{
	vec4 vertPos4 = u_modelViewMatrix * vec4(a_position, 1.0);

	gl_Position = u_projectionMatrix * vertPos4;

	v_color = a_color;
	v_texCoord = a_texCoord;
	// v_fogValue = FogEyeRadial(vertPos4);
	// v_fogValue = 0.0;

	// v_vertPos = vec3(vertPos4) / vertPos4.w;
	vec3 vertPos = vec3(vertPos4) / vertPos4.w;
	v_lightDir = normalize(k_lightPos - vertPos);

	// v_normalInterp = vec3(u_modelViewMatrix * vec4(a_normal, 0.0));
	v_normalInterp = normalize(vec3(u_modelViewMatrix * vec4(a_normal, 0.0)));
}
